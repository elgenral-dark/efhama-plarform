{
  "buildCommand": "node scripts/copy-pyodide.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bb-e.onrender.com/api/:path*" },
    { "source": "/data/:path*", "destination": "https://bb-e.onrender.com/data/:path*" }
  ],
  "headers": [
    {
      "source": "/programming-paths/python-runner.html",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src blob:; connect-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/programming-paths/python-runner.js",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/vendor/pyodide/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}