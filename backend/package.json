{
  "name": "efhama-backend",
  "version": "1.0.0",
  "description": "افهمها — الباك اند (API + قاعدة البيانات + المحتوى المدفوع)",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test test/api.test.js",
    "load-test": "node scripts/load-test.js",
    "reset-admin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\src\\reset-admin.ps1",
    "reset-admin-node": "node --env-file-if-exists=.env src/reset-admin.js",
    "setup-windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\SETUP-WINDOWS.ps1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-edge-tts": "^1.2.12",
    "pg": "^8.13.0",
    "pyodide": "314.0.7"
  }
}