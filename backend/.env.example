# انسخ هذا الملف إلى .env (أو اضبط المتغيرات في منصة الاستضافة)
# الباك اند يعمل على منفذ 4000 داخليًا، والواجهة (مشروع frontend) تتصل به وتعرض الموقع على 8000
PORT=4000
NODE_ENV=production
# سر توقيع الجلسات — إلزامي في الإنتاج. ولّده بـ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# حساب المسؤول الأول (يُنشأ تلقائيًا إن لم يوجد مسؤول)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
# قاعدة البيانات:
#  - للإنتاج (Neon / Postgres): ضع رابط الاتصال هنا (يتعيّن في Render كمتغير بيئة، لا تكتبه في الكود)
DATABASE_URL=
#  - بدون DATABASE_URL يُستخدم SQLite محليًا على المسار التالي (للتطوير فقط)
DB_PATH=./data/efhama.db
# إعدادات اتصال PostgreSQL، اضبط الحد الأقصى بما يناسب خطة مزود قاعدة البيانات
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000
# عدد عمال bcrypt (الافتراضي يترك نواة لمعالجة طلبات Node)
PASSWORD_WORKER_COUNT=4
PASSWORD_QUEUE_MAX=500
# false لإغلاق التسجيل الذاتي
ALLOW_REGISTRATION=true
# بما أن الواجهة تمرّر الطلبات عبر مشروع frontend، ضعها true ليعمل تحديد المعدل بعنوان الزائر الصحيح
# (لا تفعّلها إلا إذا كان الباك اند غير متاح مباشرة من الإنترنت)
TRUST_PROXY=true

# اختياري: مفتاح Gemini API لتفعيل إجابات المحاضر الذكي
GEMINI_API_KEY=
